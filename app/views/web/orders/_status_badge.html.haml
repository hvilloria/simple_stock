- if order.pending_status?
  %span.inline-flex.items-center.gap-1.px-2.5.py-1.rounded-md.text-xs.font-medium.bg-amber-100.text-amber-800
    %span ⏳
    %span Pendiente
- elsif order.confirmed_status?
  %span.inline-flex.items-center.gap-1.px-2.5.py-1.rounded-md.text-xs.font-medium.bg-green-100.text-green-800
    %span ✓
    %span Cobrada
- else
  %span.inline-flex.items-center.gap-1.px-2.5.py-1.rounded-md.text-xs.font-medium.bg-red-100.text-red-800
    %span ✕
    %span Cancelada
