#payment-invoice.bg-white.border.border-slate-200.rounded-lg.p-5{ data: { controller: "payment-invoice", "payment-invoice-open-value": open.to_s } }
  %h2.text-sm.font-semibold.text-slate-900 Factura

  %div{ data: { "payment-invoice-target": "summary" } }
    .mt-3.flex.items-center.justify-between
      - if payment.billed?
        %p.text-lg.font-semibold.text-slate-900= payment.invoice_label
        %button.text-sm.font-medium.text-slate-600.hover:text-slate-900{ type: "button", data: { action: "payment-invoice#show" } } Corregir
      - else
        %span.text-sm.text-slate-500 Sin facturar
        %button.btn-primary{ type: "button", data: { action: "payment-invoice#show" } } Facturar

  = form_with url: web_payment_path(payment), method: :patch, class: "mt-4 space-y-4 hidden",
              data: { "payment-invoice-target": "form" } do
    - if error
      .p-3.rounded-lg.bg-red-50.border-l-4.border-red-500
        %p.text-sm.text-red-700= error

    %fieldset
      %legend.text-sm.font-medium.text-slate-700.mb-2 Tipo
      .flex.flex-wrap.gap-2
        - Payment::INVOICE_TYPE_LABELS.each do |key, label|
          %label.inline-flex.items-center.px-3.py-2.border.border-slate-300.rounded-lg.text-sm.text-slate-700.cursor-pointer.has-focus-visible:ring-2.has-focus-visible:ring-slate-400.has-checked:border-slate-700.has-checked:font-semibold.has-checked:text-slate-900
            = radio_button_tag :invoice_type, key, invoice_type == key, class: "sr-only",
                               data: { action: "payment-invoice#typeChanged" }
            = label

    %div{ data: { "payment-invoice-target": "number" } }
      = label_tag :invoice_number, "Número", class: "block text-sm font-medium text-slate-700 mb-1"
      = text_field_tag :invoice_number, invoice_number, autocomplete: "off",
                       class: "w-56 px-3 py-2 border border-slate-300 rounded-lg text-sm"

    .flex.gap-2
      = submit_tag "Guardar factura", class: "btn-primary cursor-pointer"
      %button.btn-secondary{ type: "button", data: { action: "payment-invoice#hide" } } Cancelar
