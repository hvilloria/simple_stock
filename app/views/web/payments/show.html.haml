- content_for :page_title, "Cobro ##{@payment.id}"

.container.mx-auto.px-6.py-6.max-w-5xl
  = link_to "← Cobros", web_payments_path, class: "text-sm text-slate-600 hover:text-slate-900"

  .mt-2.mb-6.flex.items-start.justify-between.gap-4
    %div
      %h1.text-2xl.font-bold.text-slate-900
        = payment_title(@payment)
        - if @payment.voided_status?
          %span.ml-2.align-middle.inline-flex.px-2.py-0.5.rounded-md.border.border-slate-300.text-xs.font-medium.text-slate-600 Anulado
      %p.text-sm.text-slate-500.mt-1= payment_subtitle(@payment)
    - if @payment.active_status? && policy(@payment).void?
      = link_to "Anular cobro", new_web_payment_void_path(@payment), class: "btn-secondary"

  - if @payment.voided_status?
    .mb-6.p-4.rounded-lg.border.border-slate-300.border-l-4.border-l-slate-600.bg-white
      %p.text-sm.text-slate-700= "Cobro anulado el #{@payment.voided_at.to_date.strftime('%d/%m/%Y')} por #{@payment.voided_by&.name}. Motivo: #{@payment.void_reason}"

  .grid.grid-cols-1.lg:grid-cols-3.gap-6
    .lg:col-span-2.space-y-6
      = render "web/payments/payment_method", payment: @payment, error: @method_error
      = render "web/payments/invoice", payment: @payment, open: @form_open, error: @error,
                                       invoice_type: @invoice_type, invoice_number: @invoice_number
      = render "web/payments/allocations", payment: @payment
    = render "web/payments/cash_movements", payment: @payment
