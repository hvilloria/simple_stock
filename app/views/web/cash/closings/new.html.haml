- content_for :page_title, "Cerrar día"

= render "web/cash/days/day", day: @day, business_date: @business_date

.fixed.inset-0.z-50.overflow-y-auto{ class: "bg-slate-900/50" }
  .flex.min-h-full.items-start.justify-center.p-4
    .w-full.max-w-2xl.my-8.bg-white.rounded-lg.shadow-xl{ data: { controller: "closing-form",
        "closing-form-expected-value": @day.expected_cash,
        "closing-form-payway-recorded-value": @day.payway_recorded_total,
        "closing-form-mercado-pago-recorded-value": @day.mercado_pago_recorded_total } }

      .flex.items-center.justify-between.px-6.py-4.border-b.border-slate-200
        %h2.text-lg.font-semibold.text-slate-900= "Cerrar el día #{@business_date.strftime('%d/%m/%Y')}"
        = link_to "×", web_cash_day_path(@business_date),
            class: "text-2xl leading-none text-slate-400 hover:text-slate-600"

      - if @error
        .mx-6.mt-4.p-3.rounded-lg.bg-red-50.border-l-4.border-red-500
          %p.text-sm.text-red-700= @error

      = form_with url: web_cash_day_closing_path(@business_date), method: :post do
        .px-6.py-5.space-y-6

          -# 1. Completeness
          %section
            %h3.text-sm.font-semibold.text-slate-900.mb-2 Integridad del día
            %p.text-sm.text-slate-600
              = "El día tiene #{@day.movement_count} #{'movimiento'.pluralize(@day.movement_count)}."
            - if @day.uncollected_notes_count.positive?
              .mt-2.p-3.rounded-lg.bg-amber-50.border.border-amber-200
                %p.text-sm.text-amber-800
                  = "Quedan #{@day.uncollected_notes_count} #{'nota'.pluralize(@day.uncollected_notes_count)} de pedido sin cobrar de este día."
                %p.text-xs.text-amber-700.mt-1 No impide cerrar: el talonario también se usa para presupuestos.
            - if @day.sales_without_invoice_type_count.positive?
              .mt-2.p-3.rounded-lg.bg-amber-50.border.border-amber-200
                %p.text-sm.text-amber-800
                  = "Hay #{@day.sales_without_invoice_type_count} #{'venta'.pluralize(@day.sales_without_invoice_type_count)} sin tipo de factura asignado."
                %p.text-xs.text-amber-700.mt-1 No impide cerrar: se puede completar mañana sin reabrir el día.

          -# 2. Drawer count
          %section.pt-5.border-t.border-slate-200
            %h3.text-sm.font-semibold.text-slate-900.mb-2 Arqueo del cajón
            - if @day.expected_cash.negative?
              .p-3.rounded-lg.bg-slate-50.border.border-slate-200
                %p.text-sm.text-slate-700
                  = "El cajón no alcanzó: los fajos pusieron $#{number_ar(-@day.expected_cash)}."
                %p.text-sm.text-slate-700 A envolver: $0,00.
            - else
              .flex.items-center.justify-between.p-3.rounded-lg.bg-slate-50.border.border-slate-200
                %span.text-sm.text-slate-600 Esperado en el cajón
                %span.text-sm.font-semibold.text-slate-900= number_ar(@day.expected_cash)

            .mt-3
              %label.block.text-sm.font-medium.text-slate-700.mb-1{ for: "counted_cash" } Monto contado
              = text_field_tag :counted_cash, params[:counted_cash], id: "counted_cash",
                  placeholder: "0,00", autocomplete: "off",
                  data: { controller: "currency-input",
                          "closing-form-target": "counted",
                          action: "input->closing-form#countedChanged blur->currency-input#format focus->currency-input#unformat" },
                  class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-right"

            .mt-3{ hidden: true, data: { "closing-form-target": "note" } }
              %label.block.text-sm.font-medium.text-slate-700.mb-1{ for: "note" } ¿Sabés por qué no coincide? (opcional)
              = text_field_tag :note, params[:note], id: "note", autocomplete: "off",
                  placeholder: "Ej.: faltó vuelto de la mañana",
                  class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm"

          -# 3. Digital verification
          %section.pt-5.border-t.border-slate-200
            %h3.text-sm.font-semibold.text-slate-900.mb-1 Verificación digital
            %p.text-xs.text-slate-500.mb-3 Opcional. Informa una diferencia, no impide cerrar.

            .space-y-3
              = render "web/cash/closings/digital_field",
                  name: :payway_batch_total, label: "Lote Payway", target: "payway",
                  recorded: @day.payway_recorded_total, value: params[:payway_batch_total]
              = render "web/cash/closings/digital_field",
                  name: :mercado_pago_total, label: "Mercado Pago", target: "mercadoPago",
                  recorded: @day.mercado_pago_recorded_total, value: params[:mercado_pago_total]

          -# 4. Close
          %section.pt-5.border-t.border-slate-200
            .flex.items-center.justify-between.p-3.rounded-lg.bg-slate-50.border.border-slate-200
              %span.text-sm.font-medium.text-slate-700 A envolver
              %span.text-base.font-semibold.text-slate-900{ data: { "closing-form-target": "wrapAmount" } }
                = number_ar([ @day.expected_cash, 0 ].max)

        .flex.justify-end.gap-2.px-6.py-4.border-t.border-slate-200.bg-slate-50.rounded-b-lg
          = link_to "Cancelar", web_cash_day_path(@business_date),
              class: "px-4 py-2 border border-slate-300 text-slate-700 text-sm font-semibold rounded-lg hover:bg-white transition-colors"
          = submit_tag "Cerrar día",
              class: "px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer"
