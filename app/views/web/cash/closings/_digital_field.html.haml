.grid.grid-cols-2.gap-3.items-end
  %div
    %label.block.text-sm.font-medium.text-slate-700.mb-1{ for: name }= label
    = text_field_tag name, value, id: name, placeholder: "0,00", autocomplete: "off",
        data: { controller: "currency-input",
                "closing-form-target": "#{target}Input",
                action: "input->closing-form#digitalChanged blur->currency-input#format focus->currency-input#unformat" },
        class: "w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-right"
  .text-sm.pb-2
    %p.text-slate-500
      Registrado:
      %span.text-slate-900= number_ar(recorded)
    %p.text-amber-700.mt-0.5{ hidden: true, data: { "closing-form-target": "#{target}Diff" } }
