- content_for :page_title, "Historial de movimientos"

.container.mx-auto.px-6.py-6
  .flex.items-center.justify-between.mb-6
    %div
      %h1.text-3xl.font-bold.text-slate-900 Historial de movimientos
      %p.text-sm.text-slate-600.mt-1
        = "Del #{l(@from, format: :friendly)} al #{l(@to, format: :friendly)}"

  .bg-white.border.border-slate-200.rounded-lg.p-4.mb-6
    = form_with url: web_cash_movement_history_path, method: :get, data: { controller: "filter-form" }, class: "flex flex-col gap-3" do
      = text_field_tag :search, @search,
                       placeholder: "🔍 Buscar por descripción…",
                       autofocus: @search.present?,
                       class: "w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-all",
                       data: { action: "input->filter-form#submitWithDebounce" }

      .flex.flex-col.md:flex-row.gap-3
        = select_tag :group,
                     options_for_select([ [ "Todas las arcas", "" ] ] + @group_options, @group),
                     class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm",
                     data: { action: "change->filter-form#submit" }

        = select_tag :category,
                     options_for_select([ [ "Todas las categorías", "" ] ] + @category_options, @category),
                     class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm",
                     data: { action: "change->filter-form#submit" }

        = select_tag :period,
                     options_for_select(@period_options, @period),
                     class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm",
                     data: { action: "change->filter-form#submit" }

        = date_field_tag :from, @from,
                         id: "history-from",
                         disabled: @period != "custom",
                         class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm disabled:bg-slate-50 disabled:text-slate-400",
                         data: { action: "change->filter-form#submit" }

        = date_field_tag :to, @to,
                         id: "history-to",
                         disabled: @period != "custom",
                         class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm disabled:bg-slate-50 disabled:text-slate-400",
                         data: { action: "change->filter-form#submit" }

  - if @movements.any?
    .bg-white.border.border-slate-200.rounded-lg.overflow-x-auto
      %table.min-w-full.divide-y.divide-slate-200
        %thead.bg-slate-50
          %tr
            %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Fecha
            %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Descripción
            %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Arca
            %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Categoría
            %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider N° nota
            %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Entrada
            %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Salida

        %tbody#movement-rows.divide-y.divide-slate-100.bg-white
          - @movements.each do |movement|
            - paper_numbers = movement.paper_numbers
            - counterpart = movement.transfer_counterpart_label
            %tr.hover:bg-slate-50.transition-colors
              %td.px-4.py-3.whitespace-nowrap.text-sm.text-slate-600= l(movement.business_date, format: :friendly)
              %td.px-4.py-3.text-sm.text-slate-900
                .flex.items-center.gap-2
                  %span= movement.description
                  -# Filtered to one arca only one leg shows, so the row says where its other half is.
                  - if counterpart
                    %span.text-sm.text-slate-500= counterpart
                  - if movement.automatic?
                    %span.inline-flex.items-center.rounded.bg-slate-100.px-1.5.py-0.5.text-xs.font-medium.text-slate-500 Automático
              -# The fine arca, against the coarse filter above: read fine, filter coarse.
              %td.px-4.py-3.whitespace-nowrap.text-sm.text-slate-600= movement.account.present? ? CashMovement.account_label(movement.account) : "—"
              %td.px-4.py-3.whitespace-nowrap.text-sm.text-slate-600= CashMovement.category_label(movement.category)
              %td.px-4.py-3.text-sm.text-slate-600.font-mono.whitespace-nowrap
                - if paper_numbers.empty?
                  = "—"
                - else
                  - paper_numbers.each do |paper_number|
                    %div= paper_number
              %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= movement.inflow? ? number_ar(movement.amount) : ""
              %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= movement.outflow? ? number_ar(movement.amount.abs) : ""

  - else
    .bg-white.border.border-slate-200.rounded-lg.p-16.text-center
      .inline-flex.w-20.h-20.rounded-full.bg-slate-100.items-center.justify-center.text-4xl.mb-4
        📒
      %h3.text-xl.font-bold.text-slate-900.mb-2 No hay movimientos con esos filtros
      %p.text-slate-600.mb-6 Probá con otro período o quitá los filtros.
      = link_to "✕ Limpiar filtros", web_cash_movement_history_path, class: "inline-flex items-center justify-center px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors"

  - if @pagy.pages > 1
    .flex.items-center.justify-center.gap-1.mt-6.pb-2
      - if @pagy.prev
        = link_to "← Anterior", pagy_url_for(@pagy, @pagy.prev), class: "inline-flex items-center px-3 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
      - else
        %span.inline-flex.items-center.px-3.py-2.text-sm.font-medium.text-slate-300.bg-white.border.border-slate-200.rounded-lg.cursor-not-allowed ← Anterior

      - @pagy.series.each do |item|
        - if item.is_a?(Integer)
          = link_to item, pagy_url_for(@pagy, item), class: "inline-flex items-center justify-center w-9 h-9 text-sm font-medium text-slate-600 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
        - elsif item.is_a?(String)
          %span.inline-flex.items-center.justify-center.w-9.h-9.text-sm.font-semibold.text-white.bg-slate-700.border.border-slate-700.rounded-lg= item
        - elsif item == :gap
          %span.inline-flex.items-center.justify-center.w-9.h-9.text-sm.text-slate-400 …

      - if @pagy.next
        = link_to "Siguiente →", pagy_url_for(@pagy, @pagy.next), class: "inline-flex items-center px-3 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
      - else
        %span.inline-flex.items-center.px-3.py-2.text-sm.font-medium.text-slate-300.bg-white.border.border-slate-200.rounded-lg.cursor-not-allowed Siguiente →
