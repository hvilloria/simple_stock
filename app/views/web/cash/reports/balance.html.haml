- content_for :page_title, "Balance general"

.container.mx-auto.px-6.py-6
  .flex.items-center.justify-between.mb-6
    %div
      %h1.text-3xl.font-bold.text-slate-900 Balance general
      %p.text-sm.text-slate-600.mt-1
        = "Del #{l(@from, format: :friendly)} al #{l(@to, format: :friendly)}"

  .bg-white.border.border-slate-200.rounded-lg.p-4.mb-6
    = form_with url: web_cash_balance_report_path, method: :get, data: { controller: "filter-form" }, class: "flex flex-col md:flex-row gap-3" do
      = select_tag :period,
                   options_for_select(@period_options, @period),
                   class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm",
                   data: { action: "change->filter-form#submit" }

      = date_field_tag :from, @from,
                       id: "balance-from",
                       disabled: @period != "custom",
                       class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm disabled:bg-slate-50 disabled:text-slate-400",
                       data: { action: "change->filter-form#submit" }

      = date_field_tag :to, @to,
                       id: "balance-to",
                       disabled: @period != "custom",
                       class: "px-4 py-2.5 border border-slate-300 rounded-xl text-sm disabled:bg-slate-50 disabled:text-slate-400",
                       data: { action: "change->filter-form#submit" }

  .bg-white.border.border-slate-200.rounded-lg.overflow-x-auto
    %table.min-w-full.divide-y.divide-slate-200
      %thead.bg-slate-50
        %tr
          %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Arca
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Saldo inicial
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Ventas
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Proveedores
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Gastos fijos
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Socio
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Entre arcas
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Diferencias
          %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Saldo final

      %tbody#balance-rows.divide-y.divide-slate-100.bg-white
        - @rows.each do |row|
          %tr.hover:bg-slate-50.transition-colors
            %td.px-4.py-3.whitespace-nowrap.text-sm.font-semibold.text-slate-900= row.label
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= number_ar(row.opening)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= number_ar(row.sales)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= number_ar(row.suppliers)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= number_ar(row.fixed_expenses)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= number_ar(row.partner)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.text-slate-900= number_ar(row.transfers)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm{ class: row.discrepancies.zero? ? "text-slate-900" : "text-amber-700 font-semibold" }= number_ar(row.discrepancies)
            %td.px-4.py-3.whitespace-nowrap.text-right.text-sm.font-bold.text-slate-900= number_ar(row.closing)
