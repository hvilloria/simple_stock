#transfer-preview{ data: { "cash-transfer-target": "preview" } }
  - if error.present?
    %p.mt-2.text-sm.text-red-700= error
  - elsif legs.present?
    .mt-3.border.border-slate-200.rounded-lg.overflow-hidden.bg-white
      .px-3.py-2.border-b.border-slate-200
        %p.text-xs.text-slate-500 Se van a registrar estos dos movimientos:
      %table.min-w-full.divide-y.divide-slate-100
        %thead.bg-slate-50
          %tr
            %th.px-3.py-2.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Arca
            %th.px-3.py-2.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Descripción
            %th.px-3.py-2.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Ingreso
            %th.px-3.py-2.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Egreso
        %tbody.divide-y.divide-slate-100
          - legs.each do |leg|
            %tr
              %td.px-3.py-2.text-sm.text-slate-900= CashMovement.account_label(leg.account)
              %td.px-3.py-2.text-sm.text-slate-600= leg.description.presence || CashMovement.category_label(leg.category)
              %td.px-3.py-2.text-sm.text-right.text-slate-900= leg.inflow? ? number_ar(leg.amount) : ""
              %td.px-3.py-2.text-sm.text-right.text-slate-900= leg.outflow? ? number_ar(leg.amount.abs) : ""
      .px-3.py-2.bg-slate-50.border-t.border-slate-200.text-right
        -# The confirmation replays the values that produced this preview, not
        -# whatever the form holds now.
        = form_with url: web_cash_transfers_path do
          = hidden_field_tag :business_date, fields[:business_date]
          = hidden_field_tag :from, fields[:from]
          = hidden_field_tag :to, fields[:to]
          = hidden_field_tag :amount, fields[:amount]
          = hidden_field_tag :description, fields[:description]
          = submit_tag "Confirmar",
                       class: "px-3 py-2 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold rounded-lg"
