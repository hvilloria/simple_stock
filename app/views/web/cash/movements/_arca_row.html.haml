%tr{ id: dom_id(movement), class: "hover:bg-slate-50 transition-colors" }
  %td.px-4.py-3.text-sm.text-slate-900
    .flex.items-center.gap-2
      %span= movement.description
      - if movement.automatic?
        %span.inline-flex.items-center.rounded.bg-slate-100.px-1.5.py-0.5.text-xs.font-medium.text-slate-500 Automático
      - if movement.transfer?
        %span.inline-flex.items-center.rounded.bg-slate-100.px-1.5.py-0.5.text-xs.font-medium.text-slate-500 Entre arcas
    %p.text-xs.text-slate-500= movement.subcategory.present? ? CashMovement.subcategory_label(movement.subcategory) : CashMovement.category_label(movement.category)
  %td.px-4.py-3.text-sm.text-slate-600= movement.account.present? ? CashMovement.account_label(movement.account) : "—"
  %td.px-4.py-3.text-sm.text-right.text-slate-900= movement.inflow? ? number_ar(movement.amount) : ""
  %td.px-4.py-3.text-sm.text-right.text-slate-900= movement.outflow? ? number_ar(movement.amount.abs) : ""
  %td.px-4.py-3.text-right
    -# `editable` is the day's fact; the policy owns the row's.
    - if editable && policy(movement).update?
      .flex.items-center.justify-end.gap-2
        = link_to "Editar", edit_web_cash_movement_path(movement), data: { turbo_stream: true },
                  class: "text-sm font-medium text-slate-600 hover:text-slate-900"
        = button_to "Eliminar", web_cash_movement_path(movement), method: :delete,
                    form: { data: { turbo_confirm: "¿Eliminar este movimiento?" } },
                    class: "text-sm font-medium text-slate-500 hover:text-red-700"
