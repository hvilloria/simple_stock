.container.mx-auto.px-6.py-6
  .flex.items-center.justify-between.mb-6
    %div
      %h1.text-3xl.font-bold.text-slate-900= business_date.strftime("%d/%m/%Y")
      - if day.closed?
        %p.text-sm.text-slate-500.mt-1 Día cerrado — solo lectura

    .flex.items-center.gap-2
      = link_to "← Día anterior", web_cash_day_path(business_date - 1),
                class: "px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors"
      = link_to "Hoy", web_cash_day_path(Date.current),
                class: "px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors"
      = link_to "Día siguiente →", web_cash_day_path(business_date + 1),
                class: "px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors"
      - unless day.closed? || day.future?
        = link_to "Cerrar el día", new_web_cash_day_closing_path(business_date),
                  class: "px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold rounded-lg transition-colors"

  .grid.grid-cols-1.lg:grid-cols-3.gap-6
    .lg:col-span-2.space-y-6
      - unless day.closed? || day.future?
        = render "web/cash/entries/form", business_date: business_date, suppliers: suppliers, error: nil
      = render "web/cash/days/entries", day: day
    = render "web/cash/days/sales_by_channel", day: day
