.bg-white.border.border-slate-200.rounded-lg.overflow-hidden{ id: "sales-by-channel" }
  .px-4.py-3.border-b.border-slate-200
    %h2.text-sm.font-semibold.text-slate-900 Ventas por canal

  - sales = day.sales_by_channel
  - if sales.present?
    .divide-y.divide-slate-100
      - sales.each do |channel, amount|
        .flex.items-center.justify-between.px-4.py-2
          %span.text-sm.text-slate-600= CashMovement.channel_label(channel)
          %span.text-sm.text-slate-900= number_ar(amount)
  - else
    .px-4.py-6.text-center
      %p.text-sm.text-slate-500 No hay ventas cargadas en este día.

  .px-4.py-3.bg-slate-50.border-t.border-slate-200.flex.items-center.justify-between
    %span.text-sm.font-medium.text-slate-700 Monto a fajar
    %span.text-sm.font-semibold.text-slate-900= number_ar(day.amount_to_wrap)
