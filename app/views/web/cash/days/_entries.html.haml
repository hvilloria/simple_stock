- entries = day.entries

.bg-white.border.border-slate-200.rounded-lg.overflow-hidden
  %table.min-w-full.divide-y.divide-slate-200
    %thead.bg-slate-50
      %tr
        %th.pl-4.py-3.w-8
          %span.sr-only Sentido
        %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Descripción
        %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Nota
        %th.px-4.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Canal
        %th.px-4.py-3.text-right.text-xs.font-medium.text-slate-500.uppercase.tracking-wider Monto
        %th.py-3.w-6
          %span.sr-only Cajón
        %th.px-4.py-3.w-24
    %tbody#day-entries.divide-y.divide-slate-100.bg-white
      = render partial: "web/cash/entries/entry", collection: entries, as: :entry, locals: { editable: !day.closed? }

  - if entries.empty?
    .p-12.text-center
      %p.text-slate-500 No hay movimientos cargados en este día.
