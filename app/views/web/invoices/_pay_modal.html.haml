-# Pay this invoice: pick the arca the money leaves and the day it left.
#payInvoiceModal{ class: "hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center" }
  .bg-white.rounded-lg.p-6.max-w-md.w-full.mx-4{ onclick: "event.stopPropagation()",
    data: { controller: "invoice-payment",
            invoice_payment_full_value: invoice.total_amount_ars.to_f,
            invoice_payment_discounted_value: invoice.amount_with_discount_ars.to_f,
            invoice_payment_deadline_value: invoice.early_payment_due_date&.iso8601.to_s } }
    .flex.items-center.justify-between.mb-4
      %h3.text-lg.font-semibold.text-slate-900= "Pagar factura #{invoice.reference}"
      %button.text-slate-400{ class: "hover:text-slate-600", type: "button", onclick: "document.getElementById('payInvoiceModal').classList.add('hidden')" }
        %span.text-2xl ×

    = form_with url: mark_as_paid_web_invoice_path(invoice), method: :post, local: true do |f|
      .mb-4
        %p.block.text-sm.font-medium.text-slate-700.mb-2 Sale de
        .grid.grid-cols-2.gap-2
          - invoice_payment_account_options.each do |label, key|
            %label{ class: "flex items-center justify-center px-3 py-2 border border-slate-300 rounded-lg cursor-pointer text-sm text-slate-700 has-[:checked]:border-slate-700 has-[:checked]:bg-slate-50 has-[:checked]:font-semibold has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-slate-500" }
              = radio_button_tag :account, key, false, class: "sr-only", data: { action: "change->invoice-payment#refresh" }
              = label

      .mb-4
        %label.block.text-sm.font-medium.text-slate-700.mb-2{ for: "payment_date" } Fecha de pago
        = date_field_tag :payment_date, Date.current, max: Date.current, required: true,
                         class: "w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-all",
                         data: { invoice_payment_target: "date", action: "change->invoice-payment#refresh" }
        %p.text-xs.text-slate-500.mt-1 Un día de caja cerrado no acepta pagos.

      .flex.justify-between.items-baseline.border-t.border-slate-200.pt-3.mb-4
        %span.text-sm.text-slate-600{ data: { invoice_payment_target: "origin" } } Elegí de dónde sale la plata
        %span.text-lg.font-semibold.text-slate-900.tabular-nums{ data: { invoice_payment_target: "amount" } }

      .flex.items-center.gap-3
        %button.flex-1.px-4.py-2.border.border-slate-300.text-slate-700.font-semibold.rounded-lg.transition-colors{ class: "hover:bg-slate-50", type: "button", onclick: "document.getElementById('payInvoiceModal').classList.add('hidden')" }
          Cancelar
        = f.submit "Confirmar pago", data: { invoice_payment_target: "submit" },
                   class: "flex-1 px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
