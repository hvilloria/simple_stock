.bg-white.border.border-slate-200.rounded-lg.p-6
  %h3.text-lg.font-semibold.text-gray-900.mb-1 Qué factura
  %p.text-xs.text-gray-500.mb-4 Los tipos de factura que se pueden registrar con este proveedor

  = hidden_field_tag "supplier[expense_types][]", "", id: nil
  .grid.grid-cols-1.sm:grid-cols-2.gap-3
    - Invoice.expense_type_options.each do |label, key|
      %label{ for: "supplier_expense_types_#{key}", class: "flex items-center gap-3 px-4 py-3 border border-slate-300 rounded-lg cursor-pointer text-sm text-slate-700 has-[:checked]:border-slate-700 has-[:checked]:bg-slate-50 has-[:checked]:font-semibold" }
        = check_box_tag "supplier[expense_types][]", key, supplier.expense_types.include?(key),
                        id: "supplier_expense_types_#{key}",
                        class: "w-5 h-5 rounded border-slate-300 text-slate-700 focus:ring-slate-500"
        = label
