- content_for :page_title, "Cobrar pago a cuenta"

.container.mx-auto.px-6.py-6{ data: { controller: "on-account-payment", "on-account-payment-balance-value": @order.outstanding_balance, "on-account-payment-pending-delivery-value": (!@order.fully_delivered?).to_s } }

  .flex.items-baseline.justify-between.mb-6
    %div
      %p.text-xs.font-medium.uppercase.tracking-wider.text-slate-500 Talonario
      %h1.text-3xl.font-semibold.text-slate-900= @order.paper_number
    = link_to "← Volver al listado", web_payments_on_account_path(@order), class: "text-sm text-slate-500 hover:text-slate-900"

  - if flash.now[:alert]
    .bg-red-50.border.border-red-200.text-red-700.text-sm.rounded-xl.px-4.py-3.mb-4= flash.now[:alert]

  = form_with url: web_payments_on_account_payment_path(@order), method: :post, data: { action: "submit->on-account-payment#confirmSettle" } do |f|
    = hidden_field_tag :confirmed_overpaid, "0", data: { "on-account-payment-target": "confirmedOverpaid" }

    .grid.grid-cols-1.gap-5{ class: "lg:grid-cols-[1fr_360px]" }

      -# LEFT column
      .space-y-4

        -# Read-only products
        .bg-white.border.border-slate-200.rounded-2xl.p-5
          .flex.items-baseline.justify-between.mb-3
            %h3.text-sm.font-semibold.text-slate-900 Productos
            %span.text-xs.text-slate-500
              = pluralize(@order.order_items.size, "ítem")
          %table.w-full.text-sm
            %thead
              %tr.text-slate-500.text-left
                %th.py-2.font-medium.border-b.border-slate-100 Producto
                %th.py-2.font-medium.border-b.border-slate-100.text-center Cant
                %th.py-2.font-medium.border-b.border-slate-100.text-right Subtotal
                %th.py-2.font-medium.border-b.border-slate-100.text-center Entrega
            %tbody.text-slate-900
              - @order.order_items.each do |oi|
                %tr
                  %td.py-2= oi.product.name
                  %td.py-2.text-center= oi.quantity
                  %td.py-2.text-right= number_to_currency(oi.quantity * oi.unit_price, unit: "$", separator: ",", delimiter: ".")
                  %td.py-2.text-center
                    - if oi.delivered_at
                      %span.text-xs.text-emerald-700 entregado
                    - else
                      %span.text-xs.text-slate-400 pendiente

        -# What the customer hands over, one row per method
        .bg-white.border.border-slate-200.rounded-2xl.p-5
          .flex.items-baseline.justify-between.mb-1
            %h3.text-sm.font-semibold.text-slate-900 ¿Cuánto recibís?
            %span.text-xs.text-slate-500 Podés dividir el cobro en varios métodos
          %p.text-xs.text-slate-500.mb-3 Lo que entrega el cliente, por método

          .space-y-2{ data: { "on-account-payment-target": "tenderRows" } }
            .flex.gap-2.items-center{ data: { "on-account-payment-target": "tenderRow" } }
              = select_tag "tenders[0][payment_method]",
                  options_for_select(Payment.method_options, "cash"),
                  data: { "on-account-payment-target": "tenderMethod",
                          action: "change->on-account-payment#recalculate" },
                  class: "flex-1 px-3 py-2 border border-slate-300 rounded-xl text-sm"
              = text_field_tag "tenders[0][amount]", nil,
                  placeholder: "0,00",
                  autocomplete: "off",
                  data: { "on-account-payment-target": "tenderAmount",
                          controller: "currency-input",
                          action: "blur->currency-input#format focus->currency-input#unformat input->on-account-payment#recalculate" },
                  class: "w-36 px-3 py-2 border border-slate-300 rounded-xl text-sm text-right bg-white"
              %button{ type: "button",
                       data: { action: "click->on-account-payment#removeTender" },
                       class: "text-slate-400 hover:text-red-500 text-lg px-1" } ×

          %button{ type: "button",
                   data: { action: "click->on-account-payment#addTender" },
                   class: "mt-3 w-full text-xs text-slate-600 hover:text-slate-900 border border-dashed border-slate-300 rounded-xl py-2" }
            + Agregar método

          %button{ type: "button",
                   data: { action: "click->on-account-payment#settleAll", "on-account-payment-target": "settleAllButton" },
                   class: "mt-3 text-xs text-slate-700 underline hover:text-slate-900" }
            Saldar todo

        -# Discount
        .bg-white.border.border-slate-200.rounded-2xl.p-5
          %h3.text-sm.font-semibold.text-slate-900.mb-1 Descuento
          %p.text-xs.text-slate-500.mb-3{ data: { "on-account-payment-target": "discountHelper" } }
            Solo si todo es en efectivo
          = select_tag :discount_percent,
              options_for_select([["0%", 0], ["5%", 5], ["10%", 10]], 0),
              data: { "on-account-payment-target": "discount", action: "change->on-account-payment#recalculate" },
              class: "w-32 px-3 py-2 border border-slate-300 rounded-xl text-sm bg-white"

      -# RIGHT column — summary
      .bg-white.border.border-slate-200.rounded-2xl.p-5.h-fit.lg:sticky.lg:top-6

        %h3.text-sm.font-semibold.text-slate-900.mb-3 Resumen

        .space-y-2.text-sm
          .flex.justify-between.text-slate-600
            %span Debe hoy
            %span= number_to_currency(@order.outstanding_balance, unit: "$", separator: ",", delimiter: ".")
          .flex.justify-between.text-slate-600
            %span Recibís
            %span{ data: { "on-account-payment-target": "receivedLine" } } $ 0,00
          .flex.justify-between.text-slate-600{ data: { "on-account-payment-target": "discountRow" }, hidden: true }
            %span{ data: { "on-account-payment-target": "discountLabel" } } Descuento en efectivo
            %span{ data: { "on-account-payment-target": "discountLine" } } $ 0,00
          %div{ data: { "on-account-payment-target": "resultRows" } }
            .border-t.border-slate-200.my-2
            .flex.justify-between.font-semibold.text-slate-900
              %span Baja la deuda en
              %span{ data: { "on-account-payment-target": "settledLine" } } $ 0,00
            .border-t.border-slate-200.my-2
            .flex.justify-between.font-semibold.text-slate-900
              %span Queda debiendo
              %span{ data: { "on-account-payment-target": "balanceAfter" } } $ 0,00
            .flex.justify-between.text-slate-600{ data: { "on-account-payment-target": "overpaidRow" }, hidden: true }
              %span Cobrado de más
              %span{ data: { "on-account-payment-target": "overpaidLine" } } $ 0,00
          %p.mt-3.p-3.rounded-lg.border.border-slate-300.bg-slate-50.text-slate-700{ data: { "on-account-payment-target": "excessNotice" }, hidden: true }

        = f.submit "Registrar cobro",
            data: { "on-account-payment-target": "submitButton" },
            class: "mt-5 w-full bg-slate-900 hover:bg-slate-800 text-white py-2.5 rounded-xl text-sm font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
